<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:padding="22dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:padding="8dp"
                android:text="ANDROID • JAVA PROJECT"
                android:textColor="#233FAD"
                android:textSize="10sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="API Connect"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Explore internet data with Retrofit and Volley."
                android:textColor="#E1E8FF"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="JSONPlaceholder • Demo API"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Choose a request"
            android:textColor="#17213B"
            android:textSize="20sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Tap any option to send a request to the API."
            android:textColor="#77819A"
            android:textSize="13sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01  Retrofit GET"
                android:textColor="#17213B"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Fetch post details using Retrofit and Gson."
                android:textColor="#77819A"
                android:textSize="12sp"/>
            <Button
                android:id="@+id/btnRetrofit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_button_primary"
                android:text="Load with Retrofit"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="02  Volley GET"
                android:textColor="#17213B"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Fetch and parse a JSON response with Volley."
                android:textColor="#77819A"
                android:textSize="12sp"/>
            <Button
                android:id="@+id/btnVolley"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Load with Volley"
                android:textAllCaps="false"
                android:textColor="#233FAD"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="03  Volley POST"
                android:textColor="#17213B"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Send sample data to create a demo post."
                android:textColor="#77819A"
                android:textSize="12sp"/>
            <Button
                android:id="@+id/btnPost"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Create Post"
                android:textAllCaps="false"
                android:textColor="#233FAD"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API RESPONSE"
                android:textColor="#3157D5"
                android:textSize="11sp"
                android:textStyle="bold"/>
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="14dp"
                android:indeterminate="true"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/txtResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="5dp"
                android:text="Your API result will appear here. Choose a request above to get started."
                android:textColor="#56617A"
                android:textSize="14sp"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Learning Android Networking"
            android:textColor="#9AA3B7"
            android:textSize="11sp"/>
    </LinearLayout>
</ScrollView>
